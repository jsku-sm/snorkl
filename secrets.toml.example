# Streamlit Cloud: App settings > Secrets 에 아래 내용을 붙여넣고 값을 바꾸세요.
# 이 파일의 이름은 그대로 예시용으로 두고, 실제 비밀값은 GitHub에 올리지 않습니다.
THINK_MODE = "github"
GITHUB_REPO = "내깃허브아이디/비공개데이터저장소"
GITHUB_BRANCH = "main"
GITHUB_TOKEN = "비공개데이터저장소에만_Contents_Read_and_write_권한이_있는_토큰"
ENCRYPTION_KEY = "기존에사용하던Fernet키또는처음만든키"
THINK_TEACHER_ID = "teacher"
THINK_TEACHER_PASSWORD = "직접정한_10자이상_비밀번호"

AI_ENABLED = true
OPENAI_API_KEY = "본인의_API키"
OPENAI_MODEL = "gpt-4.1-mini"
TRANSCRIPTION_MODEL = "gpt-4o-mini-transcribe"

# 로컬 파일 저장으로 시험하려면 THINK_MODE = "local" 로 바꿉니다.
# 로컬 모드도 ENCRYPTION_KEY, THINK_TEACHER_PASSWORD가 필요합니다.
# 설정 없이 실행하면 세션 임시 체험 모드입니다.
